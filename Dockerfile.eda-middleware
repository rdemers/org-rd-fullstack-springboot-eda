# ----------------------------------------------------------------------------------------
# org-rd-fullstack/eda-middleware
# ----------------------------------------------------------------------------------------
# Development middleware image for Event-Driven Architecture (EDA).
# Services:
#   PostgreSQL : localhost:5432
#   Kafka      : localhost:9092
#   Hazelcast  : localhost:5701
#   Flink REST : localhost:8081
#
# Kafka runs in KRaft mode. ZooKeeper is not required.
#
# Build:
# docker build -f Dockerfile.eda-middleware -t org-rd-fullstack/eda-middleware:latest .
# docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.eda-middleware -t org-rd-fullstack/eda-middleware:unspecified .
# docker buildx build --platform linux/arm64 -f Dockerfile.eda-middleware -t org-rd-fullstack/eda-middleware:arm64 .
# docker buildx build --platform linux/amd64 -f Dockerfile.eda-middleware -t org-rd-fullstack/eda-middleware:amd64 .
#
# Run:
# docker run -it --rm \
#   --name eda-middleware \
#   -p 5432:5432 \
#   -p 9092:9092 \
#   -p 5701:5701 \
#   -p 6123:6123 \
#   -p 8081:8081 \
#   -e POSTGRES_PASSWORD=postgres \
#   org-rd-fullstack/eda-middleware:arm64 or amd64 or unspecified
#
# YAML (Spring Boot):
# spring:
#   kafka:
#     bootstrap-servers: localhost:9092
#   datasource:
#     url: jdbc:postgresql://localhost:5432/postgres
#     username: postgres
#     password: postgres
# hazelcast-client:
#   cluster-name: dev
#   network:
#     cluster-members:
#       - localhost:5701
#
# IMPORTANT:
# This image is intended for development, demonstration and training purposes.
# In production environments, each middleware should normally be deployed and
# managed independently.
#
# R. Demers; 2026.
# ----------------------------------------------------------------------------------------
FROM ubuntu:24.04

# ----------------------------------------------------------------------------------------
# Versions
# ----------------------------------------------------------------------------------------
ARG KAFKA_VERSION=4.3.1
ARG SCALA_VERSION=2.13
ARG HAZELCAST_VERSION=5.7.0
ARG FLINK_VERSION=2.3.0

# ----------------------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive
ENV KAFKA_HOME=/opt/kafka
ENV HAZELCAST_HOME=/opt/hazelcast
ENV FLINK_HOME=/opt/flink
ENV PGDATA=/var/lib/postgresql/data

# Development default only.
# Override when starting the container with:
#   -e POSTGRES_PASSWORD=<password>
ENV POSTGRES_PASSWORD=postgres

# Kafka address announced to clients.
# The default value is appropriate for applications running directly
# on the Docker host.
ENV KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
ENV PATH="${KAFKA_HOME}/bin:${FLINK_HOME}/bin:${PATH}"

# ----------------------------------------------------------------------------------------
# Base packages
# ----------------------------------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       netcat-openbsd \
       openjdk-21-jre-headless \
       postgresql-16 \
       postgresql-client-16 \
       supervisor \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------------------------
# Directories
# ----------------------------------------------------------------------------------------
RUN mkdir -p \
       ${KAFKA_HOME} \
       ${HAZELCAST_HOME} \
       ${FLINK_HOME} \
       /var/lib/kafka/data \
       /var/lib/postgresql/data \
    && chown -R postgres:postgres /var/lib/postgresql

# ========================================================================================
# Kafka
# ========================================================================================
# Kafka runs as a single-node KRaft cluster.
# Listener:
#   Broker     : 9092
#   Controller : 9093 (internal)
# ----------------------------------------------------------------------------------------
RUN curl -fsSL \
       "https://downloads.apache.org/kafka/${KAFKA_VERSION}/kafka_${SCALA_VERSION}-${KAFKA_VERSION}.tgz" \
       -o /tmp/kafka.tgz \
    && tar -xzf /tmp/kafka.tgz \
       --strip-components=1 \
       -C ${KAFKA_HOME} \
    && rm /tmp/kafka.tgz

# ----------------------------------------------------------------------------------------
# Kafka configuration
# ----------------------------------------------------------------------------------------
RUN cat > ${KAFKA_HOME}/config/server.properties <<'EOF'
# ----------------------------------------------------------------------------------------
# Kafka - Single node KRaft configuration
# ----------------------------------------------------------------------------------------
process.roles=broker,controller
node.id=1

# ----------------------------------------------------------------------------------------
# KRaft controller
# ----------------------------------------------------------------------------------------
controller.quorum.bootstrap.servers=localhost:9093
controller.listener.names=CONTROLLER

# ----------------------------------------------------------------------------------------
# Listeners
# ----------------------------------------------------------------------------------------
listeners=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
advertised.listeners=PLAINTEXT://localhost:9092
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
inter.broker.listener.name=PLAINTEXT

# ----------------------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------------------
log.dirs=/var/lib/kafka/data

# ----------------------------------------------------------------------------------------
# Broker
# ----------------------------------------------------------------------------------------
num.network.threads=3
num.io.threads=8
num.partitions=3
num.recovery.threads.per.data.dir=1

# ----------------------------------------------------------------------------------------
# Single node system topics
# ----------------------------------------------------------------------------------------
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1

# ----------------------------------------------------------------------------------------
# Development
# ----------------------------------------------------------------------------------------
group.initial.rebalance.delay.ms=0
EOF

# ----------------------------------------------------------------------------------------
# Kafka startup
# ----------------------------------------------------------------------------------------
RUN cat > /usr/local/bin/start-kafka.sh <<'EOF'
#!/bin/bash

set -e

KAFKA_HOME=/opt/kafka
CONFIG=${KAFKA_HOME}/config/server.properties
DATA=/var/lib/kafka/data

# ----------------------------------------------------------------------------------------
# Configure advertised listener.
#
# This allows the value to be overridden when the container is started:
#
#   -e KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://host.docker.internal:9092
#
# ----------------------------------------------------------------------------------------
sed -i \
    "s|^advertised.listeners=.*|advertised.listeners=${KAFKA_ADVERTISED_LISTENERS}|" \
    "${CONFIG}"

# ----------------------------------------------------------------------------------------
# Initialize KRaft storage only once.
# ----------------------------------------------------------------------------------------
if [ ! -f "${DATA}/meta.properties" ]; then
    echo "--------------------------------------------------------------------------------"
    echo "Initializing Kafka KRaft storage"
    echo "--------------------------------------------------------------------------------"

    CLUSTER_ID="$(${KAFKA_HOME}/bin/kafka-storage.sh random-uuid)"

    ${KAFKA_HOME}/bin/kafka-storage.sh format \
        --standalone \
        --cluster-id "${CLUSTER_ID}" \
        --config "${CONFIG}"
fi

echo "--------------------------------------------------------------------------------"
echo "Starting Kafka"
echo "--------------------------------------------------------------------------------"
exec ${KAFKA_HOME}/bin/kafka-server-start.sh "${CONFIG}"
EOF

RUN chmod +x /usr/local/bin/start-kafka.sh

# ========================================================================================
# PostgreSQL
# ========================================================================================
RUN cat > /usr/local/bin/start-postgresql.sh <<'EOF'
#!/bin/bash
set -e
PGDATA=/var/lib/postgresql/data
PGBIN=/usr/lib/postgresql/16/bin

# ----------------------------------------------------------------------------------------
# Initialize PostgreSQL only once.
# ----------------------------------------------------------------------------------------
if [ ! -s "${PGDATA}/PG_VERSION" ]; then
    echo "--------------------------------------------------------------------------------"
    echo "Initializing PostgreSQL"
    echo "--------------------------------------------------------------------------------"
    mkdir -p "${PGDATA}"
    chown postgres:postgres "${PGDATA}"
    chmod 700 "${PGDATA}"

    # ------------------------------------------------------------------------------------
    # Initialize the PostgreSQL cluster.
    # ------------------------------------------------------------------------------------
    su postgres -c \
       "${PGBIN}/initdb -D ${PGDATA}"

    # ------------------------------------------------------------------------------------
    # Allow PostgreSQL connections from outside the container.
    # ------------------------------------------------------------------------------------
    cat >> "${PGDATA}/postgresql.conf" <<EOT

# ----------------------------------------------------------------------------------------
# Docker development configuration
# ----------------------------------------------------------------------------------------
listen_addresses = '*'
port = 5432
EOT

    cat >> "${PGDATA}/pg_hba.conf" <<EOT

# ----------------------------------------------------------------------------------------
# Docker development access
# ----------------------------------------------------------------------------------------
host all all 0.0.0.0/0 scram-sha-256
host all all ::/0      scram-sha-256
EOT

    # ------------------------------------------------------------------------------------
    # Temporarily start PostgreSQL to initialize the postgres password.
    # ------------------------------------------------------------------------------------
    su postgres -c \
       "${PGBIN}/pg_ctl -D ${PGDATA} -w start"

    su postgres -c \
       "${PGBIN}/psql -v ON_ERROR_STOP=1 -c \"ALTER USER postgres PASSWORD '${POSTGRES_PASSWORD}';\""

    su postgres -c \
       "${PGBIN}/pg_ctl -D ${PGDATA} -m fast -w stop"
fi
echo "--------------------------------------------------------------------------------"
echo "Starting PostgreSQL"
echo "--------------------------------------------------------------------------------"
exec su postgres -c \
    "${PGBIN}/postgres -D ${PGDATA}"
EOF
RUN chmod +x /usr/local/bin/start-postgresql.sh

# ========================================================================================
# Hazelcast
# ========================================================================================
# Single Hazelcast member.
# Port:
#   5701
# ----------------------------------------------------------------------------------------
RUN curl -fsSL \
       "https://repo1.maven.org/maven2/com/hazelcast/hazelcast/${HAZELCAST_VERSION}/hazelcast-${HAZELCAST_VERSION}.jar" \
       -o "${HAZELCAST_HOME}/hazelcast.jar"

# ----------------------------------------------------------------------------------------
# Hazelcast configuration
# ----------------------------------------------------------------------------------------
RUN cat > ${HAZELCAST_HOME}/hazelcast.yaml <<'EOF'
hazelcast:
  cluster-name: dev
  network:
    port:
      port: 5701
      auto-increment: false
    # ------------------------------------------------------------------------------------
    # Address announced to clients running on the Docker host.
    # ------------------------------------------------------------------------------------
    public-address: localhost:5701
    join:
      multicast:
        enabled: false
      tcp-ip:
        enabled: false
EOF

# ----------------------------------------------------------------------------------------
# Hazelcast startup
# ----------------------------------------------------------------------------------------
RUN cat > /usr/local/bin/start-hazelcast.sh <<'EOF'
#!/bin/bash
set -e
echo "--------------------------------------------------------------------------------"
echo "Starting Hazelcast"
echo "--------------------------------------------------------------------------------"
exec java \
    --add-modules java.se \
    --add-exports java.base/jdk.internal.ref=ALL-UNNAMED \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    --add-opens java.base/java.nio=ALL-UNNAMED \
    --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
    --add-opens java.management/sun.management=ALL-UNNAMED \
    --add-opens jdk.management/com.ibm.lang.management.internal=ALL-UNNAMED \
    --add-opens jdk.management/com.sun.management.internal=ALL-UNNAMED \
    -Dhazelcast.config=/opt/hazelcast/hazelcast.yaml \
    -jar /opt/hazelcast/hazelcast.jar
EOF
RUN chmod +x /usr/local/bin/start-hazelcast.sh

# ========================================================================================
# Apache Flink
# ========================================================================================
# Flink standalone cluster:
#   1 JobManager
#   1 TaskManager
# REST / Web UI:
#   http://localhost:8081
# ----------------------------------------------------------------------------------------
RUN curl -fsSL \
       "https://downloads.apache.org/flink/flink-${FLINK_VERSION}/flink-${FLINK_VERSION}-bin-scala_2.12.tgz" \
       -o /tmp/flink.tgz \
    && tar -xzf /tmp/flink.tgz \
       --strip-components=1 \
       -C ${FLINK_HOME} \
    && rm /tmp/flink.tgz

# ----------------------------------------------------------------------------------------
# Flink configuration
# ----------------------------------------------------------------------------------------
RUN cat > ${FLINK_HOME}/conf/config.yaml <<'EOF'
# ----------------------------------------------------------------------------------------
# Flink development configuration
# ----------------------------------------------------------------------------------------
jobmanager.rpc.address: localhost
jobmanager.rpc.port: 6123
rest.address: localhost
rest.bind-address: 0.0.0.0
rest.port: 8081
taskmanager.numberOfTaskSlots: 4
parallelism.default: 1
EOF

# ========================================================================================
# Health check
# ========================================================================================
RUN cat > /usr/local/bin/healthcheck.sh <<'EOF'
#!/bin/bash

# ----------------------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------------------
pg_isready \
    -h localhost \
    -p 5432 \
    -U postgres \
    > /dev/null 2>&1 \
    || exit 1

# ----------------------------------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------------------------------
/opt/kafka/bin/kafka-broker-api-versions.sh \
    --bootstrap-server localhost:9092 \
    > /dev/null 2>&1 \
    || exit 1

# ----------------------------------------------------------------------------------------
# Hazelcast
# ----------------------------------------------------------------------------------------
nc -z localhost 5701 \
    || exit 1

# ----------------------------------------------------------------------------------------
# Flink REST API
# ----------------------------------------------------------------------------------------
curl \
    --fail \
    --silent \
    http://localhost:8081/overview \
    > /dev/null \
    || exit 1

exit 0
EOF

RUN chmod +x /usr/local/bin/healthcheck.sh

# ========================================================================================
# Supervisor
# ========================================================================================
# Supervisor is used because this development image intentionally runs multiple
# independent middleware processes in a single Docker container.
# ----------------------------------------------------------------------------------------
RUN cat > /etc/supervisor/conf.d/eda-middleware.conf <<'EOF'
[supervisord]
nodaemon=true
user=root
logfile=/dev/null
logfile_maxbytes=0
pidfile=/tmp/supervisord.pid

# ----------------------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------------------
[program:postgresql]
command=/usr/local/bin/start-postgresql.sh
autorestart=true
startsecs=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=10

# ----------------------------------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------------------------------
[program:kafka]
command=/usr/local/bin/start-kafka.sh
autorestart=true
startsecs=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=20

# ----------------------------------------------------------------------------------------
# Hazelcast
# ----------------------------------------------------------------------------------------
[program:hazelcast]
command=/usr/local/bin/start-hazelcast.sh
autorestart=true
startsecs=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=30

# ----------------------------------------------------------------------------------------
# Flink JobManager
# ----------------------------------------------------------------------------------------
[program:flink-jobmanager]
command=/opt/flink/bin/jobmanager.sh start-foreground
autorestart=true
startsecs=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=40

# ----------------------------------------------------------------------------------------
# Flink TaskManager
# ----------------------------------------------------------------------------------------
[program:flink-taskmanager]
command=/opt/flink/bin/taskmanager.sh start-foreground
autorestart=true
startsecs=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=50
EOF

# ========================================================================================
# Network
# ========================================================================================
# PostgreSQL
EXPOSE 5432
# Kafka
EXPOSE 9092
# Hazelcast
EXPOSE 5701
# Flink JobManager RPC
EXPOSE 6123
# Flink REST / Web UI
EXPOSE 8081

# ========================================================================================
# Persistent data
# ========================================================================================
VOLUME ["/var/lib/postgresql/data"]
VOLUME ["/var/lib/kafka/data"]

# ========================================================================================
# Docker health check
# ========================================================================================
HEALTHCHECK \
    --interval=30s \
    --timeout=15s \
    --start-period=60s \
    --retries=3 \
    CMD ["/usr/local/bin/healthcheck.sh"]

# ========================================================================================
# Startup
# ========================================================================================
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]